# Temporary runner output generated by tests
hooks/js/__tests__/fixtures/

# Dependency bootstrap failure markers (run-time artifacts, do not commit)
.iconv-install-failed
.clang-format-install-failed

# iconv-lite ships with the plugin, so node_modules must be committed (overrides the node_modules/ rule in the repo-root .gitignore)
!node_modules/
!node_modules/**
