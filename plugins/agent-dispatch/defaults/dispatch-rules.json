{
  "schema_version": 3,
  "modules": {
    "enforcer": false,
    "subagent_git_guard": true,
    "prompt_inject": true,
    "session_guidance": true,
    "subagent_guidance": true,
    "subagent_report_guard": true
  },
  "policy": {
    "max_parallel_subagents": 3,
    "require_changed_file_report": true,
    "require_validation_report": true,
    "require_blocker_report": true
  },
  "whitelist": {
    "tools": [
      "Agent", "SendMessage",
      "TaskCreate", "TaskUpdate", "TaskList", "TaskGet", "TaskOutput", "TaskStop", "TodoWrite",
      "TeamCreate", "TeamDelete", "ToolSearch",
      "AskUserQuestion",
      "EnterPlanMode", "ExitPlanMode",
      "EnterWorktree", "ExitWorktree",
      "Skill", "Workflow",
      "CronCreate", "CronDelete", "CronList", "ScheduleWakeup",
      "Read", "Grep", "Glob", "LSP",
      "Edit", "Write", "MultiEdit", "NotebookEdit",
      "WebFetch", "WebSearch"
    ],
    "mcp_prefixes": [
      "mcp__plugin_context-mode_",
      "mcp__context-mode__",
      "mcp__plugin_claude-mem_",
      "mcp__sequential-thinking",
      "mcp__plugin_codemap-boost_",
      "mcp__code_review_graph__",
      "mcp__code-review-graph__",
      "mcp__codegraph__",
      "mcp__graphify__",
      "mcp__serena__",
      "mcp__serena-cross-platform__"
    ],
    "mcp_block_exact": [
      "mcp__plugin_context-mode_context-mode__ctx_execute",
      "mcp__plugin_context-mode_context-mode__ctx_execute_file",
      "mcp__plugin_context-mode_context-mode__ctx_batch_execute"
    ],
    "bash_safe_heads": [
      "ls", "pwd", "cd",
      "cat", "echo", "which", "where",
      "fd", "rg", "grep", "jq", "delta", "gh", "tsc", "pyright", "pdftotext",
      "head", "tail", "wc", "sort", "uniq",
      "node", "npm", "yarn", "pnpm", "bun",
      "python", "python3", "pip", "pipenv", "poetry",
      "codegraph", "code-review-graph", "graphify",
      "rustc", "cargo",
      "go",
      "java", "javac", "mvn", "gradle",
      "dotnet",
      "ruby", "gem", "bundle",
      "gcc", "g++", "clang", "clang++",
      "cmake", "make", "ninja", "meson",
      "msbuild", "cl",
      "uname", "whoami", "hostname", "printenv"
    ],
    "prompt_keywords": [
      "审查", "review", "audit", "排查", "debug", "调试", "分析", "analy",
      "实现", "implement", "迁移", "migrate", "重构", "refactor", "构建", "build",
      "跨模块", "多文件", "并行", "parallel", "调查", "investigat", "research"
    ],
    "bash_dangerous_patterns": [
      "^rm\\b",
      "^docker(?:-compose)?\\s+(?:rm|rmi|stop|kill|down|system\\s+prune)\\b",
      "^podman\\s+(?:rm|rmi|stop|kill|system\\s+prune)\\b",
      "^kubectl\\s+(?:delete|apply|patch|replace|scale|drain)\\b",
      "^helm\\s+(?:uninstall|delete|upgrade|install|rollback)\\b"
    ]
  },
  "overrides": {
    "tools_add": [],
    "tools_remove": [],
    "mcp_prefixes_add": [],
    "mcp_prefixes_remove": [],
    "mcp_block_exact_add": [],
    "mcp_block_exact_remove": [],
    "bash_heads_add": [],
    "bash_heads_remove": [],
    "prompt_keywords_add": [],
    "prompt_keywords_remove": []
  }
}
